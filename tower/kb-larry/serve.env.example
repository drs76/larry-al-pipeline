# ~/.config/kb/serve.env on Larry (chmod 600, gitignored on the host). Template only.
# DB on LOCAL disk (never NFS — NFS+SQLite corrupts, see EN-8). Embeds via local ollama.
KB_DB=$HOME/.local/share/kb/kb.db
KB_EMBED_URL=http://localhost:11434/v1/embeddings
KB_SERVE_TOKEN=<generate: openssl rand -base64 24 | tr -d /+=>
KB_SERVE_HOST=0.0.0.0
KB_SERVE_PORT=8848
